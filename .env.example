# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://license_backend:<PASSWORD>@<CLUSTER>.mongodb.net/premium_license?retryWrites=true&w=majority

# JWT & Security Secrets
JWT_ACCESS_SECRET=your_super_secret_random_hex_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# Admin Dashboard Origin for CORS
ADMIN_ORIGIN=http://localhost:5173

# Admin Setup Secret (Used for bootstrap seeding)
ADMIN_SETUP_SECRET=your_admin_bootstrap_secret_key

